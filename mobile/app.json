{
  "expo": {
    "name": "Aguialarmas Técnicos",
    "slug": "aguialarmas-tecnicos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.aguialarmas.tecnicos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.aguialarmas.tecnicos",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "aguialarmas",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aguialarmas usa tu ubicación solo cuando marcas una acción (llegada, inicio, pausa, cierre).",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Aguialarmas usa la cámara para las fotos de evidencia de la orden.",
          "photosPermission": "Aguialarmas usa tus fotos para adjuntar evidencias a la orden."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#141414"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/aguila.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
